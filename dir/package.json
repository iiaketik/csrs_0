{
  "name": "catsalers-archive",
  "version": "1.0.0",
  "private": true,
  "description": "CATSALERS Archive — Telegram Mini App drop / market / collage",
  "main": "server/index.js",
  "scripts": {
    "postinstall": "npm --prefix web install",
    "dev": "concurrently -n api,web -c cyan,magenta \"node --watch server/index.js\" \"npm --prefix web run dev\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node server/index.js",
    "test": "node test-rarities.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "sql.js": "^1.11.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
